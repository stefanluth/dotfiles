{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/INSTRUCTIONS.md"],
  "permission": {
    "read": {
      ".env*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env*": "deny"
    },
    "edit": {
      ".env*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env*": "deny"
    },
    "write": {
      ".env*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env*": "deny"
    },
    "bash": {
      "grep*.env*": "deny",
      "cat*.env*": "deny",
      "rg*.env*": "deny",
      "find*.env*": "deny",
      "sed*.env*": "deny",
      "awk*.env*": "deny",
      "*.env*": "deny",
      "printenv*": "deny"
    },
    "grep": {
      ".env*": "deny",
      "*.env*": "deny",
      "*.env.*": "deny",
      "**/*.env*": "deny",
      "**/.env*": "deny",
      "**/.env.*": "deny"
    },
    "glob": {
      ".env*": "deny",
      "*.env*": "deny",
      "*.env.*": "deny",
      "**/*.env*": "deny",
      "**/.env*": "deny",
      "**/.env.*": "deny"
    }
  }
}
